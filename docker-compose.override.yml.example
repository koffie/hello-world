# Copy this file to docker-compose.override.yml and adjust the path to mount
# a local clone of gerby-website into the containers. This lets you edit
# gerby-website templates and Python files without rebuilding the image.
#
# docker-compose.override.yml is gitignored - it is personal to your machine.

services:
  gerby:
    volumes:
      - /path/to/gerby-website:/app/gerby-website

  watcher:
    volumes:
      - /path/to/gerby-website:/app/gerby-website

  gerby-plugin:
    volumes:
      - /path/to/gerby-website:/app/gerby-website

  watcher-plugin:
    volumes:
      - /path/to/gerby-website:/app/gerby-website
